{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "type": {
            "type": "string",
            "enum": [
                "FeatureCollection"
            ]
        },
        "features": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "Feature"
                        ]
                    },
                    "geometry": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "enum": [
                                    "Polygon"
                                ]
                            },
                            "coordinates": {
                                "type": "array"
                            }
                        },
                        "required": [
                            "type",
                            "coordinates"
                        ]
                    },
                    "properties": {
                        "type": "object",
                        "properties": {
                            "h3": {
                                "type": "string"
                            },
                            "ndvi": {
                                "type": "number"
                            },
                            "lst_c": {
                                "type": [
                                    "number",
                                    "null"
                                ]
                            },
                            "population": {
                                "type": "number"
                            },
                            "built_frac": {
                                "type": "number"
                            },
                            "dust_idx": {
                                "type": "number"
                            },
                            "school_count": {
                                "type": "integer"
                            },
                            "ward": {
                                "type": "string"
                            },
                            "priority": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "h3",
                            "ndvi",
                            "population",
                            "built_frac",
                            "dust_idx",
                            "school_count",
                            "ward",
                            "priority"
                        ]
                    }
                },
                "required": [
                    "type",
                    "geometry",
                    "properties"
                ]
            }
        }
    },
    "required": [
        "type",
        "features"
    ]
}